    "xiaoqing.meet": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "啊，歡迎光臨！……啊不對，你是新搬來的那位吧？我是曉晴。",
          "emote": "surprise"
        },
        {
          "speaker": "曉晴",
          "text": "抱歉，我剛剛一直在看手機。",
          "emote": "surprise"
        }
      ],
      "choices": [
        {
          "text": "沒關係。你還好嗎？想聊聊嗎？",
          "next": "xiaoqing.meet.ask"
        },
        {
          "text": "工作時別一直看手機啦，會被老闆唸喔。",
          "next": "xiaoqing.meet.advice"
        },
        {
          "text": "一定是在等重要的訊息吧？別想太多啦！",
          "next": "xiaoqing.meet.myth"
        }
      ]
    },
    "xiaoqing.meet.advice": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "哈哈……也是啦。我收起來。"
        },
        {
          "speaker": "旁白",
          "text": "她笑了一下，把手機放進口袋，但眼睛還是飄過去。好像有什麼話沒說出口。"
        }
      ],
      "choices": [
        {
          "text": "其實……你想聊聊嗎？",
          "next": "xiaoqing.meet.ask"
        }
      ]
    },
    "xiaoqing.meet.myth": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "嗯……謝謝。",
          "emote": "relief"
        },
        {
          "speaker": "旁白",
          "text": "「別想太多」常常是好意，但對方可能會覺得自己的在意沒被聽見。先問問她想不想說，通常比較能幫上忙。"
        }
      ],
      "choices": [
        {
          "text": "我是說，如果你想聊，我在。",
          "next": "xiaoqing.meet.ask"
        }
      ]
    },
    "xiaoqing.meet.ask": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "……好啊。其實很小的事啦。",
          "emote": "think"
        },
        {
          "speaker": "曉晴",
          "text": "我在群組約週末聚餐。小月已讀了，但兩個小時都沒回。"
        },
        {
          "speaker": "曉晴",
          "text": "然後我就開始想，是不是我太煩了。",
          "emote": "worry"
        }
      ],
      "choices": [
        {
          "text": "嗯，等回覆的時候真的會一直想。",
          "next": "xiaoqing.meet.listen"
        },
        {
          "text": "你最近還好嗎？",
          "next": "xiaoqing.disclose.ask"
        }
      ]
    },
    "xiaoqing.meet.listen": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "對吧！我寫了張便條想整理一下，結果越寫越亂。就放在那張桌上。"
        }
      ],
      "next": "xiaoqing.meet.end"
    },
    "xiaoqing.disclose.ask": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "嗯……接下來有點私人。你想聽嗎？不聽也完全沒關係。",
          "emote": "think"
        }
      ],
      "choices": [
        {
          "text": "你想說多少都可以。",
          "next": "xiaoqing.disclose"
        },
        {
          "text": "我們先不聊這個也可以。",
          "next": "xiaoqing.disclose.skip"
        }
      ]
    },
    "xiaoqing.disclose.skip": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "好，謝謝你。",
          "emote": "relief"
        }
      ],
      "next": "xiaoqing.meet.listen"
    },
    "xiaoqing.disclose": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "我前年被診斷有憂鬱症。現在固定回診，也有在跟諮商心理師談。"
        },
        {
          "speaker": "曉晴",
          "text": "有些日子比較累，有些日子還不錯。我還是很喜歡畫畫、研究咖啡。",
          "emote": "smile"
        },
        {
          "speaker": "曉晴",
          "text": "這是我自己的經驗，不代表每個人都一樣啦。只是說出來，好像比較輕鬆。",
          "emote": "relief"
        }
      ],
      "choices": [
        {
          "text": "謝謝你願意跟我說。",
          "next": "xiaoqing.meet.listen"
        },
        {
          "text": "（點點頭，不追問）",
          "next": "xiaoqing.meet.listen"
        },
        {
          "text": "我想先停在這裡。",
          "next": "xiaoqing.meet.listen"
        }
      ]
    },
    "xiaoqing.meet.end": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "謝謝你先問我想不想說，而不是直接叫我別想了。",
          "emote": "relief"
        },
        {
          "speaker": "旁白",
          "text": "你取得理解卡「先問，再陪伴」。理解卡可以在畫面上的「卡冊」查看，之後在適合的時候「使用理解卡」。"
        }
      ],
      "effects": [
        {
          "giveCard": "K01"
        },
        {
          "advance": {
            "from": [
              "arrive",
              "meetXiaoqing"
            ],
            "to": "thought"
          }
        },
        {
          "tutorial": "cardbook"
        }
      ]
    },
    "xiaoqing.thought": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "便條就在那張桌上。你幫我看看？我自己看都看不清楚。"
        }
      ]
    },
    "xiaoqing.clarify": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "還是沒回欸……我要不要乾脆收回那則訊息？",
          "emote": "worry"
        },
        {
          "speaker": "旁白",
          "text": "也許可以用剛拿到的理解卡，和她聊聊。（在曉晴旁邊按「使用理解卡」）"
        }
      ]
    },
    "xiaoqing.later": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "我先忙店裡的事。阿德在花園，他今天好像也怪怪的。"
        }
      ]
    },
    "xiaoqing.wrap.sent": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "我後來傳了：「不急喔，有空再回我～」"
        },
        {
          "speaker": "曉晴",
          "text": "小月還是沒回。可能在忙，也可能還沒決定。目前還不知道。",
          "emote": "worry"
        },
        {
          "speaker": "曉晴",
          "text": "不過我決定先去畫我的明信片。也可以先這樣。",
          "emote": "relief"
        }
      ],
      "effects": [
