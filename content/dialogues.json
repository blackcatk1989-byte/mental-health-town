{
  "_說明": "預寫對話。每一段（segment）有 lines（依序顯示的台詞）、可選的 effects（整段顯示完時觸發）、choices（選項）或 next（下一段）。speaker 為「旁白」時不顯示名牌，「你」代表玩家。emote 是說話者頭上的表情圖示（smile 微笑、worry 擔心、think 思考、surprise 驚訝、relief 鬆一口氣、question 疑惑、happy 開心），沒填就不顯示。effects 可用：setSide（支線進度，例如 [\"xiaoan\",\"talk\"]）、gesture（角色的動作反應）、giveCard、advance（from 列出的步驟才會前進到 to，then 是前進成功後才觸發的效果）、setFlag、minigame（thought／present）、openResources、openCardbook、tutorial、dialogue。用台灣日常口語、短句，像朋友聊天。內容草案，尚未完成專業審閱。",
  "dialogues": {
    "board.arrive": {
      "lines": [
        {
          "speaker": "旁白",
          "text": "里辦公處的公布欄。上面貼著垃圾車時間、社區花園的澆水排班，還有一張「找支持」的小海報。"
        },
        {
          "speaker": "旁白",
          "text": "海報上寫著：心理諮商、醫療和電話支持的查詢入口。畫面右上角的「找支持」隨時都能打開。"
        },
        {
          "speaker": "旁白",
          "text": "今天是很普通的一天。去咖啡店外走走吧，曉晴好像有點心不在焉。"
        }
      ],
      "effects": [
        {
          "advance": {
            "from": [
              "arrive"
            ],
            "to": "meetXiaoqing"
          }
        }
      ],
      "choices": [
        {
          "text": "看看支持資源",
          "effects": [
            {
              "openResources": true
            }
          ],
          "next": "board.arrive.end"
        },
        {
          "text": "先去咖啡店外",
          "next": "board.arrive.end"
        }
      ]
    },
    "board.arrive.end": {
      "lines": [
        {
          "speaker": "旁白",
          "text": "目前要做的事會顯示在畫面左上角。咖啡店在廣場西邊。"
        }
      ]
    },
    "board.default": {
      "lines": [
        {
          "speaker": "旁白",
          "text": "公布欄上貼著垃圾車時間、澆水排班，還有「找支持」的小海報。"
        }
      ],
      "choices": [
