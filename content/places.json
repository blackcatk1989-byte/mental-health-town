{
  "_說明": "微光里的區域與可互動物件。座標單位約 1 公尺，西北角在原點，+X 往東、+Z 往南（與 src/three/world.js 的地圖一致）。talk 依序比對 when 條件，用第一個符合的對話；puzzle 表示互動時開啟該謎題。cardTarget 為 true 的物件會出現「使用理解卡」按鈕。",
  "town": "微光里",
  "areas": [
    {
      "id": "plaza",
      "name": "小廣場",
      "description": "里民常經過的小廣場，中間有座花台，旁邊立著里辦公處的公布欄。往西是咖啡店，往東是社區花園。",
      "spawn": { "x": 18, "z": 17 }
    },
    {
      "id": "cafe",
      "name": "咖啡店外",
      "description": "咖啡店的遮陽棚下擺著幾張小桌子。有三張桌子還沒收，旁邊放著一個收桌托盤。",
      "spawn": { "x": 9, "z": 15 }
    },
    {
      "id": "garden",
      "name": "小花園",
      "description": "矮籬笆圍著的社區花園，有花圃、一串風鈴和一張木頭長椅。角落的木架前擺著三盆植物和一個澆水壺。",
      "spawn": { "x": 26.5, "z": 12 }
    }
  ],
  "objects": [
    {
      "id": "board",
      "name": "公布欄",
      "area": "plaza",
      "x": 18, "z": 9.6,
      "talk": [
        { "when": { "step": ["arrive"] }, "dialogue": "board.arrive" },
        { "dialogue": "board.default" }
      ]
    },
    {
      "id": "note",
      "name": "曉晴的便條",
      "area": "cafe",
      "x": 8.6, "z": 12.6,
      "talk": [
        { "when": { "step": ["arrive", "meetXiaoqing"] }, "dialogue": "note.early" },
        { "when": { "step": ["thought"] }, "dialogue": "note.open" },
        { "dialogue": "note.after" }
      ]
    },
    {
      "id": "tables",
      "name": "還沒收的三張桌子",
      "area": "cafe",
      "x": 9.6, "z": 8.4,
      "puzzle": "E02"
    },
    {
      "id": "chime",
      "name": "風鈴",
      "area": "garden",
      "x": 27.4, "z": 15.2,
      "talk": [
        { "when": { "step": ["present"] }, "dialogue": "chime.present" },
        { "when": { "stepFrom": "tonight" }, "dialogue": "chime.after" },
        { "dialogue": "chime.default" }
      ]
    },
    {
      "id": "bench",
      "name": "花園長椅",
      "area": "garden",
      "x": 31.5, "z": 12.8,
      "cardTarget": true,
      "notApplicable": "你看了看長椅。這張卡的想法很好，只是好像不是在這裡用的。",
      "talk": [
        { "when": { "step": ["tonight"] }, "dialogue": "bench.tonight" },
        { "dialogue": "bench.default" }
      ]
    },
    {
      "id": "pots",
      "name": "三盆植物",
      "area": "garden",
      "x": 34.0, "z": 18.0,
      "puzzle": "E01"
    }
  ]
}
