          "setFlag": "confirmedXiaoqing"
        }
      ]
    },
    "xiaoqing.wrap.wait": {
      "lines": [
        {
          "speaker": "曉晴",
          "text": "我決定先不傳了，等晚上下班再看看。"
        },
        {
          "speaker": "曉晴",
          "text": "小月到底怎麼想，目前還不知道。等的時候還是會有點悶，這也是真的。",
          "emote": "worry"
        },
        {
          "speaker": "曉晴",
          "text": "但我先把店裡的事做完。也可以先這樣。",
          "emote": "relief"
        }
      ],
      "effects": [
        {
          "setFlag": "confirmedXiaoqing"
        }
      ]
    },
